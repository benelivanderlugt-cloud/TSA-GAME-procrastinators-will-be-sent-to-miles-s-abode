[sub_resource type="GDScript" id="GDScript_5aq51"]
script/source = "extends CharacterBody2D
var jumpvelocity := -300
var charspeed := 100
var accel := 440
var groundfriction := 1800
var airresistance := 500
var prevelocity: Vector2 = Vector2.ZERO
func _physics_process(delta:float):
	
	if not is_on_floor():
		velocity+= get_gravity()*delta
	
	if Input.is_action_just_pressed(\"Jump\") and is_on_floor():
		velocity.y = jumpvelocity
	if Input.is_action_just_released(\"Jump\"):
		if velocity.y < 0:
			velocity.y *= 0.2
		
	var direction := Input.get_axis(\"Left\", \"Right\")
	if direction == 0 and is_on_floor():
		$AnimatedSprite2D.play(\"CAT IDLE\")
	else:
		$AnimatedSprite2D.stop()
	
	if direction != 0:
		
		velocity.x = move_toward(velocity.x,charspeed * direction,accel * delta)
		if (direction > 0 and velocity.x < 0) or (direction < 0 and velocity.x > 0):
				velocity.x = 0 
	
	else:
		var currentfriction := groundfriction if is_on_floor() else airresistance
		velocity.x = move_toward(velocity.x, 0, currentfriction * delta)
	if direction == -1:
		$AnimatedSprite2D.flip_h = false
	if direction == 1:
		$AnimatedSprite2D.flip_h = true
	prevelocity=velocity
	move_and_slide()
"

